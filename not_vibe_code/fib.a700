        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

            origin      62                      ; user save

usr_save:   dw          start, 0740000000000

            origin      1024

ipl:        nioc        #00a            ; stop ppt 00a
            ldea        x0, .usr_rst
            ldea        x1, .usr_save
            ld          0(x0)
            st          0(x1)
            ld          1(x0)
            st          1(x1)
            ldctl       psw1, .cw
            hlt
            reti

usr_rst:    dw          start, 0740000000000

cw:         dw          0036000000000           ; return to irql 15

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
        ; FIB - nth fibonacci number (recursive)
        ;
        ;   X0: the index
        ;
        ;   Returns: the nth fibonacci number

fib:        save        x0, x1

            movrn.rn    x0, x0
            addin.rz    x0, x0, -1
            jmp         .fib_base

            addi        x0, x0, -1
            calls       .fib
            movr        ac, x1
            addi        x0, x0, -1
            calls       .fib
            addr        x1, ac
            rets

fib_base:   movr        x0, ac
            rets

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

start:      ldea        sp, stack

            rio         x0, 0, #010
            calls       .fib
            wio         ac, 0, #010

done:       ldctl       psw1, .zero
            ldmask      .zero
            hlt

zero:       dw          0

        ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

            origin      8192

stack:      bss         0
